/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Content-Security-Policy: default-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Cross-Origin-Resource-Policy: same-origin
  Access-Control-Allow-Origin: https://www.nwpharmatech.org

/portal.html
  X-Robots-Tag: noindex, nofollow

/docs.html
  X-Robots-Tag: noindex, nofollow

/sandbox/*
  X-Robots-Tag: noindex, nofollow

/sandbox
  X-Robots-Tag: noindex, nofollow

/styles.css
  Cache-Control: public, max-age=300, must-revalidate

/nav.js
  Cache-Control: public, max-age=300, must-revalidate

# NWPT-041: Work with us loads the Turnstile security check (enquiry form) from challenges.cloudflare.com only
/work-with-us
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; script-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; connect-src 'self'

/work-with-us.html
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; script-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; connect-src 'self'
